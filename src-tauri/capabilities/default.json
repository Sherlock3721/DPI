{
  "identifier": "default",
  "description": "Default capabilities for the main window. FS access je omezen na domovský adresář ($HOME funguje i na Windows) a linuxová vyměnitelná média — na Windows jsou jiné disky (D:\\ apod.) dostupné jen přes soubory vybrané dialogem, který je povoluje za běhu.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "/media/**" }, { "path": "/run/media/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "/media/**" }, { "path": "/run/media/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "/media/**" }, { "path": "/run/media/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "/media/**" }, { "path": "/run/media/**" }]
    },
    "shell:default",
    "updater:default",
    "process:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
